{
  "name": "tempo-smart-timer",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node server/index.mjs\" \"vite\"",
    "dev:web": "vite",
    "dev:server": "node server/index.mjs",
    "dev:electron": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5001 && electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "framer-motion": "^14.14.0",
    "howler": "^2.2.4",
    "lucide-react": "^0.511.0",
    "mongoose": "^9.13.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/howler": "^2.2.13",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "wait-on": "^9.5.1"
  }
}
